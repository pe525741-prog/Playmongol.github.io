        <path d="M140 185 Q160 198 180 185" stroke="#C97B63" stroke-width="4" fill="none" stroke-linecap="round"/>
      </svg>`
    }
  ];

  // ── Estado local (se sincroniza con Firebase) ─────────────────
  let state = PLAYERS.map(p => ({...p, score: 0}));
  let weeklyWinner = null;
  let dbReady = false;

  // ── Refs de Firebase ──────────────────────────────────────────
  const scoresRef = ref(db, 'mongol/scores');
  const metaRef   = ref(db, 'mongol/meta');

  // ── Escuchar cambios en tiempo real ───────────────────────────
  onValue(scoresRef, (snapshot) => {
    const data = snapshot.val();
    if (data) {
      state = state.map(p => ({
        ...p,
        score: data[p.id] !== undefined ? data[p.id] : 0
      }));
    } else {
      // Primera vez: inicializar scores en 0
      const initial = {};
      PLAYERS.forEach(p => { initial[p.id] = 0; });
      set(scoresRef, initial);
    }
    dbReady = true;
    render();
  });

  onValue(metaRef, (snapshot) => {
    const data = snapshot.val();
    if (data) {
      weeklyWinner = data.weeklyWinner || null;
    }
    render();
  });

  // ── Helpers de fecha ──────────────────────────────────────────
  function getNextFriday15(from) {
    const d = new Date(from);
    const day = d.getDay();
    const daysUntilFri = (5 - day + 7) % 7 || 7;
    const fri = new Date(d);
    fri.setDate(d.getDate() + daysUntilFri);
    fri.setHours(15, 0, 0, 0);
    if (day === 5 && d.getHours() < 15) {
      fri.setDate(d.getDate());
    }
    return fri.getTime();
  }

  function isFridayShowWindow() {
    const now = new Date();
    return now.getDay() === 5 && now.getHours() >= 10 && now.getHours() < 15;
  }

  function isFridayResetTime() {
    const now = new Date();
    return now.getDay() === 5 && now.getHours() >= 15;
  }

  // ── Audio ─────────────────────────────────────────────────────
  function playFunnySound() {
    try {
      const ctx = new (window.AudioContext || window.webkitAudioContext)();
      const sounds = [
        () => {
          const osc = ctx.createOscillator(), gain = ctx.createGain();
          osc.connect(gain); gain.connect(ctx.destination);
          osc.type = 'sine';
          osc.frequency.setValueAtTime(150, ctx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(600, ctx.currentTime + 0.15);
          osc.frequency.exponentialRampToValueAtTime(200, ctx.currentTime + 0.4);
          gain.gain.setValueAtTime(0.5, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.5);
          osc.start(); osc.stop(ctx.currentTime + 0.5);
        },
        () => {
          const bufferSize = ctx.sampleRate * 0.4;
          const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
          const data = buffer.getChannelData(0);
          for (let i = 0; i < bufferSize; i++) data[i] = (Math.random()*2-1)*Math.pow(1-i/bufferSize,1.5);
          const source = ctx.createBufferSource(), filter = ctx.createBiquadFilter(), gain = ctx.createGain();
          filter.type = 'lowpass'; filter.frequency.value = 300;
          gain.gain.setValueAtTime(0.6, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.4);
          source.buffer = buffer;
          source.connect(filter); filter.connect(gain); gain.connect(ctx.destination);
          source.start();
        },
        () => {
          const osc = ctx.createOscillator(), gain = ctx.createGain();
          osc.connect(gain); gain.connect(ctx.destination);
          osc.type = 'sine';
          osc.frequency.setValueAtTime(800, ctx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(200, ctx.currentTime + 0.3);
          osc.frequency.exponentialRampToValueAtTime(500, ctx.currentTime + 0.5);
          gain.gain.setValueAtTime(0.4, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.6);
          osc.start(); osc.stop(ctx.currentTime + 0.6);
        },
        () => {
          [0, 0.1, 0.2, 0.3].forEach((t, i) => {
            const osc = ctx.createOscillator(), gain = ctx.createGain();
            osc.connect(gain); gain.connect(ctx.destination);
            osc.type = 'sawtooth'; osc.frequency.value = 300 + i * 80;
            gain.gain.setValueAtTime(0, ctx.currentTime + t);
            gain.gain.linearRampToValueAtTime(0.2, ctx.currentTime + t + 0.04);
            gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + t + 0.09);
            osc.start(ctx.currentTime + t); osc.stop(ctx.currentTime + t + 0.1);
          });
        }
      ];
      sounds[Math.floor(Math.random() * sounds.length)]();
    } catch(e) {}
  }

  // ── Botón secreto (triple click = reset) ─────────────────────
  let secretClicks = 0, secretTimer = null;
  document.getElementById('secret-word').addEventListener('click', function() {
    secretClicks++;
    this.classList.remove('flash'); void this.offsetWidth; this.classList.add('flash');
    clearTimeout(secretTimer);
    secretTimer = setTimeout(() => { secretClicks = 0; }, 2000);
    if (secretClicks >= 3) { secretClicks = 0; resetAll(); }
  });

  // ── Modal ganador viernes ─────────────────────────────────────
  function showWinnerModal() {
    const sorted = [...state].sort((a, b) => b.score - a.score);
    const winner = sorted[0];
    const hasAnyVotes = state.some(p => p.score > 0);
    if (!hasAnyVotes) return;

    document.getElementById('modal-winner-name').textContent = winner.name;
    document.getElementById('modal-winner-score').textContent =
      winner.score === 1 ? '1 voto de mongol 🤪' : `${winner.score} votos de mongol 🤪`;
    document.getElementById('modal-avatar').innerHTML = winner.svg;

    const medals = ['🥇','🥈','🥉','4️⃣'];
    let rankHtml = '<div class="modal-ranking-title">📊 Ranking de la semana</div>';
    sorted.forEach((p, i) => {
      rankHtml += `<div class="modal-ranking-row">
        <span>${medals[i] || '▪️'} ${p.name}</span>
        <span>${p.score} pts</span>
      </div>`;
    });
    document.getElementById('modal-ranking').innerHTML = rankHtml;

    const nextReset = getNextFriday15(Date.now());
    const diffMs = nextReset - Date.now();
    const diffH = Math.floor(diffMs / 3600000);
    const diffM = Math.floor((diffMs % 3600000) / 60000);
    let resetMsg = diffMs > 0
      ? (diffH > 0 ? `🔄 Reinicio automático en ${diffH}h ${diffM}m` : `🔄 Reinicio automático en ${diffM}m`)
      : '🔄 El reinicio ocurrirá en breve';
    document.getElementById('modal-next-reset').textContent = resetMsg;
    document.getElementById('winner-modal').classList.add('show');
  }

  window.closeWinnerModal = function() {
    document.getElementById('winner-modal').classList.remove('show');
  };

  // ── Reset (escribe en Firebase) ───────────────────────────────
  async function resetAll(silent = false) {
    // Guardar ganador en Firebase antes de borrar
    const sorted = [...state].sort((a, b) => b.score - a.score);
    if (state.some(p => p.score > 0)) {
      weeklyWinner = { id: sorted[0].id, name: sorted[0].name, score: sorted[0].score };
      await set(metaRef, { weeklyWinner, lastReset: Date.now() });
    }

    // Reiniciar scores a 0 en Firebase
    const zeros = {};
    PLAYERS.forEach(p => { zeros[p.id] = 0; });
    await set(scoresRef, zeros);

    if (!silent) {
      const toast = document.getElementById('reset-toast');
      toast.classList.add('show');
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = ctx.createOscillator(), gain = ctx.createGain();
        osc.connect(gain); gain.connect(ctx.destination);
        osc.type = 'sine';
        osc.frequency.setValueAtTime(600, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(100, ctx.currentTime + 0.6);
        gain.gain.setValueAtTime(0.4, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.7);
        osc.start(); osc.stop(ctx.currentTime + 0.7);
      } catch(e) {}
      setTimeout(() => toast.classList.remove('show'), 2000);
    }
  }

  // ── Votar (transacción atómica en Firebase) ───────────────────
  window.addPoint = async function(id) {
    if (!dbReady) return;
    const playerRef = ref(db, `mongol/scores/${id}`);
    await runTransaction(playerRef, (current) => {
      return (current || 0) + 1;
    });
    playFunnySound();
    // El onValue actualizará el estado y re-renderizará automáticamente
    const card = document.querySelector(`[data-id="${id}"]`);
    if (card) { card.classList.remove('pop'); void card.offsetWidth; card.classList.add('pop'); }
  };

  // ── Render ────────────────────────────────────────────────────
  function getLeader() {
    return [...state].sort((a, b) => b.score - a.score)[0];
  }

  function msToReadable(ms) {
    const d = Math.floor(ms / 86400000);
    const h = Math.floor((ms % 86400000) / 3600000);
    const m = Math.floor((ms % 3600000) / 60000);
    if (d > 0) return `${d}d ${h}h`;
    if (h > 0) return `${h}h ${m}m`;
    return `${m}m`;
  }

  function render() {
    const leader = getLeader();
    const hasPoints = state.some(p => p.score > 0);
    const infoBar = document.getElementById('info-bar');
    let html = '';

    // Indicador de conexión
    if (!dbReady) {
      html += `<span class="badge" style="background:#fff3cd;color:#856404">⏳ Conectando...</span>`;
    } else {
      html += `<span class="badge" style="background:#d4edda;color:#155724">🟢 En vivo</span>`;
    }

    if (hasPoints) html += `<span class="badge leader-badge">🏆 Va ganando: ${leader.name} (${leader.score} pts)</span>`;
    if (weeklyWinner) html += `<span class="badge weekly-badge">🎉 Último ganador: ${weeklyWinner.name}</span>`;

    const nextReset = getNextFriday15(Date.now());
    const remaining = nextReset - Date.now();
    if (remaining > 0) html += `<span class="badge timer-badge">🔄 Reinicio en ${msToReadable(remaining)}</span>`;

    infoBar.innerHTML = html;

    const grid = document.getElementById('grid');
    grid.innerHTML = '';
    state.forEach(p => {
      const isLeader = hasPoints && p.id === leader.id;
      const card = document.createElement('div');
      card.className = 'card' + (isLeader ? ' is-leader' : '');
      card.dataset.id = p.id;
      card.style.setProperty('--accent', p.accent);
      card.innerHTML = `
        <div class="avatar-wrap">${p.svg}</div>
        <div class="player-name">${p.name}</div>
        <div class="score-display">${p.score === 0 ? '—' : p.score}</div>
        <button class="btn-add" onclick="addPoint(${p.id})">😂 +1</button>
      `;
      grid.appendChild(card);
    });
  }

  // ── Loop de tiempo (modal + reset automático viernes) ─────────
  let fridayModalShown = false;
  let fridayResetDone = false;

  function tick() {
    if (isFridayShowWindow() && !fridayModalShown) {
      fridayModalShown = true;
      setTimeout(showWinnerModal, 800);
    }
    if (isFridayResetTime() && !fridayResetDone) {
      fridayResetDone = true;
      if (state.some(p => p.score > 0)) {
        resetAll(true).then(() => {
          const toast = document.getElementById('reset-toast');
          toast.textContent = '🔄 ¡Nueva semana!';
          toast.classList.add('show');
          setTimeout(() => { toast.classList.remove('show'); toast.textContent = '💥 ¡Reiniciado!'; }, 3000);
        });
      }
    }
    // Re-render solo para actualizar el badge del timer
    render();
  }

  // Render inicial con estado vacío mientras carga Firebase
  render();
  tick();
  setInterval(tick, 10000);
</script>

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Nunito', sans-serif;
    min-height: 100vh;
    background: #fff8f0;
    overflow-x: hidden;
  }

  .bg {
    position: fixed; inset: 0; z-index: 0;
    background: linear-gradient(160deg, #ffe4f0 0%, #fff4c2 40%, #d4f0ff 100%);
  }

  .blob {
    position: fixed; border-radius: 50%; filter: blur(60px); opacity: 0.45; z-index: 0;
  }
  .blob1 { width: 400px; height: 400px; background: #ffb3d1; top: -100px; left: -100px; animation: drift 8s ease-in-out infinite alternate; }
  .blob2 { width: 350px; height: 350px; background: #b3e4ff; bottom: -80px; right: -80px; animation: drift 10s ease-in-out infinite alternate-reverse; }
  .blob3 { width: 300px; height: 300px; background: #fff0a0; top: 40%; left: 30%; animation: drift 12s ease-in-out infinite alternate; }

  @keyframes drift { from { transform: translate(0,0) scale(1); } to { transform: translate(30px, 20px) scale(1.08); } }

  .wrapper {
    position: relative; z-index: 1;
    max-width: 860px;
    margin: 0 auto;
    padding: 32px 16px 48px;
  }

  .header { text-align: center; margin-bottom: 28px; }

  h1 {
    font-family: 'Fredoka One', cursive;
    font-size: clamp(2rem, 6vw, 3.2rem);
    color: #c0007a;
    letter-spacing: 1px;
    line-height: 1.1;
    text-shadow: 3px 3px 0 #ffd6ec;
  }

  .secret-word {
    cursor: pointer;
    user-select: none;
    display: inline-block;
    transition: transform 0.1s;
  }
  .secret-word:active { transform: scale(0.92); }
  .secret-word.flash { animation: flashRed 0.3s ease; }
  @keyframes flashRed {
    0% { color: #c0007a; }
    50% { color: #ff0000; text-shadow: 0 0 12px #ff0000; }
    100% { color: #c0007a; }
  }

  .subtitle { font-size: 1rem; color: #888; margin-top: 6px; font-weight: 600; }

  .info-bar {
    display: flex; justify-content: center; gap: 12px; flex-wrap: wrap;
    margin-bottom: 28px;
  }

  .badge {
    background: white;
    border-radius: 999px;
    padding: 8px 20px;
    font-size: 0.9rem;
    font-weight: 700;
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
